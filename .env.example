# ---------------------------------------------------------------------------
# AlertRadar backend configuration
# Copy to `.env` and fill in. Everything here is read by app/config.py.
# ---------------------------------------------------------------------------

# --- Infrastructure --------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://alertradar:alertradar@db:5432/alertradar
REDIS_URL=redis://redis:6379/0

# --- Gemini ----------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cheaper/faster alternatives: gemini-3.5-flash-lite (cheapest),
# gemini-2.5-flash. More capable: gemini-3.7-flash. Confirm the id against
# https://ai.google.dev/gemini-api/docs/models before changing it.
LLM_MODEL=gemini-3.5-flash

# MINIMAL | LOW | MEDIUM | HIGH — leave EMPTY for the Gemini 2.5 family, which
# uses thinking_budget instead of thinking_level and will reject this.
LLM_THINKING_LEVEL=LOW

# How aggressively Gemini's content filters block.
#   BLOCK_LOW_AND_ABOVE | BLOCK_MEDIUM_AND_ABOVE | BLOCK_ONLY_HIGH | BLOCK_NONE | OFF
# This workload is entirely munitions vocabulary, so the stricter settings
# cause the model to return nothing during exactly the windows that matter.
# BLOCK_ONLY_HIGH is the recommended floor; watch the `llm_refused` log line
# and loosen to BLOCK_NONE only if you see real threats being dropped.
LLM_SAFETY_THRESHOLD=BLOCK_ONLY_HIGH

LLM_MAX_TOKENS=8192
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=3
LLM_CONCURRENCY=2

# Hard requests-per-day cap to ration against. Free tier: 500 on flash-lite,
# 20 on flash. RPM (15) never binds at these window widths — the daily total is
# the only real constraint. 0 disables rationing.
LLM_DAILY_REQUEST_BUDGET=500
# Slice of the day's budget spendable ahead of schedule, so a barrage that
# starts early is not throttled for it.
LLM_BUDGET_BURST_RATIO=0.15
LLM_BUDGET_TIMEZONE=America/Los_Angeles

# --- Telegram (Telethon) ---------------------------------------------------
# From https://my.telegram.org/apps
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
# Generate once with: python scripts/login.py
TELEGRAM_SESSION=
# Comma-separated channel usernames or numeric ids.
TELEGRAM_CHANNELS=some_monitor_channel,another_channel

# --- Batching --------------------------------------------------------------
BATCH_WINDOW_SECONDS=45
BATCH_MAX_MESSAGES=60
BATCH_MIN_MESSAGE_CHARS=8

# Verbatim reposts already seen this recently are dropped before the model
# sees them; a window that is nothing but reposts costs no call at all. The
# main lever for staying inside a free-tier request/day cap. Keep it well
# under DEFAULT_TTL_MINUTES — see RepostFilter in app/worker.py. 0 disables.
BATCH_REPOST_TTL_SECONDS=300

# How long a confirmed threat keeps the prefilter wide open. Mid-wave these
# channels post position updates carrying no munition vocabulary at all
# ("Розворот на Бровари!"), which no keyword list can catch. Costs little:
# windows close on a timer, so more messages means fuller windows, not more
# LLM calls. 0 disables.
ATTACK_MODE_TTL_SECONDS=900

# --- Threat model ----------------------------------------------------------
DEFAULT_TTL_MINUTES=20
MIN_CONFIDENCE=0.35
HIGH_CONFIDENCE=0.65
# Risk-corridor buffer around the core sector polygons, in metres.
BUFFER_METERS_SHAHED=15000
BUFFER_METERS_MISSILE=30000
BUFFER_METERS_RECON=10000
# Radius applied when the LLM returns raw coordinates instead of a district.
POINT_RADIUS_METERS=12000
# Fuzzy-match threshold for district names (pg_trgm similarity, 0..1).
SECTOR_MATCH_THRESHOLD=0.45

# Nominal cruise speeds used to ESTIMATE an arrival time when no message
# stated one — which, on real traffic, is nearly always (1 in 41 historically).
# Published figures, not measurements: recalibrate against threat_history once
# you have enough of it. raw->>'eta_source' records which ETAs were guessed.
CRUISE_KMH_SHAHED=180
CRUISE_KMH_MISSILE=800
CRUISE_KMH_RECON=140
# Below this origin-to-target separation the estimate is dropped rather than
# reported: Kyiv oblast wraps around Kyiv, so "approaching from Kyiv oblast"
# yields 4 km and any ETA derived from it is noise.
ETA_MIN_APPROACH_METERS=5000

# --- Hot path --------------------------------------------------------------
# How often the API polls Redis for a new threat snapshot, in seconds.
SNAPSHOT_POLL_SECONDS=2.0
JANITOR_INTERVAL_SECONDS=60
# Map overlay thinning. Display only — point-in-polygon lookups always run
# against the exact geometry. The tolerance is Douglas-Peucker in degrees
# (0.005 is ~400-550 m at Ukraine's latitude); the vertex ceiling escalates it
# per shape, because a tolerance bounds a shape's error and not its size: at
# 0.005 one Kyiv district is 21 vertices and a whole oblast is still ~690.
# Set ZONES_MAX_VERTICES=0 to disable the ceiling.
ZONES_SIMPLIFY_DEGREES=0.005
ZONES_PRECISION=4
ZONES_MAX_VERTICES=200

LOG_LEVEL=INFO
